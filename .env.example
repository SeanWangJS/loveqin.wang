# ==============================================================================
# Cloudflare Credentials & Production Configuration Template
# ==============================================================================

# Cloudflare Account & API Credentials (用于本地 CLI 自动化运维与同步)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare D1 边缘数据库配置
CLOUDFLARE_D1_DATABASE_NAME=gallery-d1
CLOUDFLARE_D1_DATABASE_ID=4610848e-16dd-4bae-901b-6a429f08d101

# 可选：指定执行环境 (production / preview / local)
CLOUDFLARE_ENV=production

# Cloudflare R2 私有媒体对象存储配置
CLOUDFLARE_R2_BUCKET_NAME=gallery-media-private
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# 受控照片导入目标（远程导入必填，必须对应生产 D1 中已存在的记录）
PHOTO_IMPORT_HOUSEHOLD_ID=household_your_family_id
PHOTO_IMPORT_ALBUM_ID=album_your_album_id
PHOTO_IMPORT_CREATED_BY_USER_ID=user_your_importer_id
PHOTO_IMPORT_CREATED_BY_EMAIL=importer@example.com
PHOTO_IMPORT_CREATED_BY_DISPLAY_NAME=Photo Importer
PHOTO_IMPORT_TIMEZONE_OFFSET_MINUTES=480

# 运行环境标示 (local / preview / production)
ENVIRONMENT=local

# Cloudflare Access 零信任身份接入配置 (用于服务端 JWT 验签)
CF_ACCESS_TEAM_DOMAIN=loveqin
CF_ACCESS_AUD=your_access_application_aud_tag_here
