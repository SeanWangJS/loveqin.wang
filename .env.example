# ==============================================================================
# Cloudflare Credentials & Production Configuration Template
# ==============================================================================

# Cloudflare Account & API Credentials (用于本地 CLI 自动化运维与同步)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare D1 边缘数据库配置
CLOUDFLARE_D1_DATABASE_NAME=gallery-d1
CLOUDFLARE_D1_DATABASE_ID=6e3d2319-b0c2-4886-90e8-0912165eb3f8

# 可选：指定执行环境 (production / preview / local)
CLOUDFLARE_ENV=production

# Cloudflare R2 私有媒体对象存储配置
CLOUDFLARE_R2_BUCKET_NAME=gallery-media-private
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# 运行环境标示 (local / preview / production)
ENVIRONMENT=local
